# Copy to .env (never commit .env). Only the backend reads these.
# Free key: https://developer.tomtom.com  (Traffic Flow + Traffic Incidents; free tier is rate-limited per day)
TOMTOM_API_KEY=your_tomtom_key_here
PORT=3000
# Server-side cache for traffic responses, seconds
TRAFFIC_CACHE_SECONDS=120

# --- Authority server (admin/server.js). No default password: login is refused until both are set. ---
ADMIN_USER=officer
ADMIN_PASSWORD=change_me_long_random
ADMIN_PORT=4000
